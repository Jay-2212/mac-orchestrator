{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mac-orchestrator-release-manifest-v1",
  "title": "Mac Orchestrator release manifest",
  "description": "Integrity and compatibility metadata for one immutable arm64 release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "bootstrap",
    "platform",
    "helper",
    "runtime",
    "ngrok",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "Mac Orchestrator"
        },
        "version": {
          "$ref": "#/definitions/version"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": {
          "$ref": "#/definitions/version"
        },
        "url": {
          "$ref": "#/definitions/assetUrl"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "minimumMacOS"],
      "properties": {
        "architecture": {
          "const": "arm64"
        },
        "minimumMacOS": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "architecture", "bundleIdentifier", "version", "signing"],
      "properties": {
        "url": {
          "$ref": "#/definitions/assetUrl"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "architecture": {
          "const": "arm64"
        },
        "bundleIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "version": {
          "$ref": "#/definitions/version"
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "adhoc"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "uv", "python", "lockSha256", "corePayload"],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "uv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "url", "sha256"],
          "properties": {
            "version": {
              "$ref": "#/definitions/version"
            },
            "url": {
              "$ref": "#/definitions/assetUrl"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managedVersion"],
          "properties": {
            "managedVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "lockSha256": {
          "$ref": "#/definitions/sha256"
        },
        "corePayload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "format", "files"],
          "properties": {
            "url": {
              "$ref": "#/definitions/assetUrl"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            },
            "format": {
              "const": "tar.gz"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[^/][^/]*$"
              }
            }
          }
        }
      }
    },
    "ngrok": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "archiveUrl",
        "archiveSha256",
        "archiveFormat",
        "executableName",
        "developerIdAuthority",
        "developerIdTeam",
        "agentApiVersion"
      ],
      "properties": {
        "version": {
          "$ref": "#/definitions/version"
        },
        "archiveUrl": {
          "type": "string",
          "pattern": "^https://bin\\.equinox\\.io/[^\\s]+$"
        },
        "archiveSha256": {
          "$ref": "#/definitions/sha256"
        },
        "archiveFormat": {
          "const": "zip"
        },
        "executableName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "developerIdAuthority": {
          "type": "string",
          "minLength": 1
        },
        "developerIdTeam": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "agentApiVersion": {
          "const": "v3"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeSchema", "configurationSchema"],
      "properties": {
        "runtimeSchema": {
          "$ref": "#/definitions/schemaRange"
        },
        "configurationSchema": {
          "$ref": "#/definitions/schemaRange"
        }
      }
    }
  },
  "definitions": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "not": {
        "pattern": "^0{64}$"
      }
    },
    "assetUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/Jay-2212/mac-orchestrator/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?/[^\\s]+$"
    },
    "schemaRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
